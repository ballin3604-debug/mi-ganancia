# Copia este archivo como .env y completa los valores.
# El .env real NO se sube al repo (esta en .gitignore).
# Para staging usa .env.staging.local, que tambien esta ignorado.
# Los valores estan en el panel de Supabase: Project Settings > API.

# Entorno de ejecucion: production | staging | test.
# Si se omite, se usa el modo de Vite (production por defecto).
VITE_APP_ENV=

# --- Produccion ---
# Staging NO usa estas variables. Se leen solo fuera de staging.

# URL del proyecto de Supabase de produccion.
VITE_SUPABASE_URL=

# Clave publica "anon" de produccion. No uses la service_role.
VITE_SUPABASE_ANON_KEY=

# Ref del proyecto de produccion (la parte xxxxxxxx de la URL).
VITE_SUPABASE_PROJECT_REF=

# UID del usuario que puede entrar al Panel de Administracion en produccion.
# En staging esta variable se ignora a proposito.
VITE_ADMIN_UID=

# --- Staging ---
# Solo se leen con --mode staging. VITE_APP_ENV=staging sin ese modo se rechaza.
# Nunca reutilices aqui valores de produccion.

VITE_STAGING_SUPABASE_URL=
VITE_STAGING_SUPABASE_ANON_KEY=
VITE_STAGING_SUPABASE_PROJECT_REF=
VITE_STAGING_ADMIN_UID=

# Ref publico del proyecto de produccion. Obligatorio en staging para
# demostrar que el proyecto de staging es distinto. No es un secreto:
# aparece en la URL publica del cliente.
VITE_PRODUCTION_SUPABASE_PROJECT_REF=
