# Copia este archivo como .env y completa los valores.
# El .env real NO se sube al repo (esta en .gitignore).
# Los valores estan en el panel de Supabase: Project Settings > API.

# URL del proyecto de Supabase (ej: https://xxxxxxxx.supabase.co)
VITE_SUPABASE_URL=

# Clave publica "anon". Es la que va en el cliente, no la service_role.
VITE_SUPABASE_ANON_KEY=

# UID del usuario que puede entrar al Panel de Administracion.
# Se saca de Supabase: Authentication > Users.
VITE_ADMIN_UID=
